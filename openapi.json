                "type": "null"
              }
            ],
            "title": "Merchantname"
          },
          "rail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rail"
          },
          "rawDescription": {
            "title": "Rawdescription",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "txnDate": {
            "title": "Txndate",
            "type": "string"
          }
        },
        "required": [
          "id",
          "txnDate",
          "amountPaise",
          "direction",
          "rawDescription",
          "title",
          "rail",
          "accountMasked",
          "merchantName",
          "counterpartyName",
          "counterpartyVpa",
          "categorySlug",
          "categoryName",
          "categorySource",
          "categoryConfidence",
          "isTransfer",
          "accountLabel"
        ],
        "title": "TransactionOut",
        "type": "object"
      },
      "UnlockRequest": {
        "properties": {
          "accountId": {
            "title": "Accountid",
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "remember": {
            "default": false,
            "title": "Remember",
            "type": "boolean"
          }
        },
        "required": [
          "accountId",
          "password"
        ],
        "title": "UnlockRequest",
        "type": "object"
      },
      "UnlockResponse": {
        "properties": {
          "stillLocked": {
            "title": "Stilllocked",
            "type": "integer"
          },
          "unlocked": {
            "title": "Unlocked",
            "type": "integer"
          }
        },
        "required": [
          "unlocked",
          "stillLocked"
        ],
        "title": "UnlockResponse",
        "type": "object"
      },
      "UploadResponse": {
        "properties": {
          "accepted": {
            "title": "Accepted",
            "type": "integer"
          },
          "duplicates": {
            "title": "Duplicates",
            "type": "integer"
          },
          "locked": {
            "title": "Locked",
            "type": "integer"
          }
        },
        "required": [
          "accepted",
          "locked",
          "duplicates"
        ],
        "title": "UploadResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WaitlistResponse": {
        "properties": {
          "onWaitlist": {
            "const": true,
            "default": true,
            "title": "Onwaitlist",
            "type": "boolean"
          }
        },
        "title": "WaitlistResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Bank statements in Gmail, turned into one combined spend report.",
    "title": "Todd API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/categories": {
      "get": {
        "description": "Every category a transaction can be moved into, in display order.",
        "operationId": "list_categories_v1_categories_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoriesResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Categories to file under",
        "tags": [
          "screens"
        ]
      }
    },
    "/v1/categories/{slug}/transactions": {
      "get": {
        "description": "Rows behind a bar on the report, for the window it was drawn for.\n\nReads `v_publishable_transactions`, so a statement that failed the\nreconciliation gate contributes nothing here either.\n\n`direction` picks which side of the ledger: `debit` mirrors\n`v_category_spend` exactly, `credit` mirrors the \"Came in\" breakdown. A\ndrill-down whose total differs from the bar that opened it is worse than\nno drill-down at all, so the filters have to match on both sides.",
        "operationId": "category_transactions_v1_categories__slug__transactions_get",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "title": "Slug",
              "type": "string"
            }
          },
          {
            "description": "1, 3, 6 or 12.",
            "in": "query",
            "name": "months",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "1, 3, 6 or 12.",
              "title": "Months"
            }
          },
          {
            "description": "debit for spend, credit for income",
            "in": "query",
            "name": "direction",
            "required": false,
            "schema": {
              "default": "debit",
              "description": "debit for spend, credit for income",
              "enum": [
                "debit",
                "credit"
              ],
              "title": "Direction",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 200,
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryTransactionsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "The transactions behind one category bar",
        "tags": [
          "screens"
        ]
      }
    },
    "/v1/documents": {
      "get": {
        "operationId": "list_documents_v1_documents_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DocumentOut"
                  },
                  "title": "Response List Documents V1 Documents Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Stored statements",
        "tags": [
          "documents"
        ]
      },
      "post": {
        "description": "Store each PDF, then parse it.\n\nCounts answer the three things the web app distinguishes: accepted,\nwaiting on a password, and already seen. A duplicate is identified by\ncontent hash, so the same statement forwarded twice is one document.",
        "operationId": "upload_documents_v1_documents_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_documents_v1_documents_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Upload statement PDFs",
        "tags": [
          "documents"
        ]
      }
    },
    "/v1/documents/{documentId}/unlock": {
      "post": {
        "operationId": "unlock_document_v1_documents__documentId__unlock_post",
        "parameters": [
          {
            "in": "path",
            "name": "documentId",
            "required": true,
            "schema": {
              "title": "Documentid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UnlockRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnlockResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Password for one locked PDF",
        "tags": [
          "documents"
        ]
      }
    },
    "/v1/gmail": {
      "delete": {
        "description": "Forget the connection and ask Google to revoke the grant.\n\nThe stored token is deleted whether or not the revoke call succeeds: a\ndisconnect the user asked for must not depend on Google being reachable.",
        "operationId": "gmail_disconnect_v1_gmail_delete",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "boolean"
                  },
                  "title": "Response Gmail Disconnect V1 Gmail Delete",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Disconnect, revoke token, stop watch",
        "tags": [
          "gmail"
        ]
      }
    },
    "/v1/gmail/callback": {
      "get": {
        "description": "Google sends the browser here. Always redirect \u2014 never render JSON at a\nhuman.\n\nThis route deliberately does **not** depend on the authenticated session.\nA browser arriving from Google carries no bearer token, so requiring one\nwould make the callback 401 the moment `AUTH_DEV_BYPASS` is off. The\n`oauth_states` row is the credential: single use, short lived, and it names\nthe user. The session is opened unscoped to read that row, then scoped to\nthe user it names before anything is written.",
        "operationId": "gmail_callback_v1_gmail_callback_get",
        "parameters": [
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "default": "",
              "title": "State",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "code",
            "required": false,
            "schema": {
              "default": "",
              "title": "Code",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "error",
            "required": false,
            "schema": {
              "default": "",
              "title": "Error",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "OAuth redirect target",
        "tags": [
          "gmail"
        ]
      }
    },
    "/v1/gmail/status": {
      "get": {
        "operationId": "gmail_status_v1_gmail_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GmailStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Connection plus live backfill progress",
        "tags": [
          "gmail"
        ]
      }
    },
    "/v1/gmail/sync": {
      "post": {
        "operationId": "gmail_sync_v1_gmail_sync_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Gmail Sync V1 Gmail Sync Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Catch-up sync",
        "tags": [
          "gmail"
        ]
      }
    },
    "/v1/goals": {
      "get": {
        "operationId": "get_goals_v1_goals_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GoalsLockedResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Locked Pro tab with teasers",
        "tags": [
          "goals"
        ]
      }
    },
    "/v1/goals/waitlist": {
      "post": {
        "operationId": "join_waitlist_v1_goals_waitlist_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WaitlistResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Join the Pro waitlist",
        "tags": [
          "goals"
        ]
      }
    },
    "/v1/profile": {
      "get": {
        "operationId": "get_profile_v1_profile_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Plan, accounts and their status",
        "tags": [
          "screens"
        ]
      }
    },
    "/v1/report": {
      "get": {
        "operationId": "get_report_v1_report_get",
        "parameters": [
          {
            "description": "1, 3, 6 or 12. Omit for the saved one.",
            "in": "query",
            "name": "months",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "1, 3, 6 or 12. Omit for the saved one.",
              "title": "Months"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Home \u2014 the whole report",
        "tags": [
          "screens"
        ]
      }
    },
    "/v1/sources/gmail/connect": {
      "post": {
        "description": "Start consent. The web app POSTs this with **no body**, so no body model\nis declared here \u2014 one would make an empty POST a 422 (\u00a76).",
        "operationId": "gmail_connect_v1_sources_gmail_connect_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GmailConnectResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Begin consent, returns {authUrl}",
        "tags": [
          "gmail"
        ]
      }
    },
    "/v1/transactions/{transaction_id}/category": {
      "post": {
        "description": "Move one transaction, and optionally every future one from the payee.\n\nA correction is the top of the ladder \u2014 confidence 1.0, `category_source`\nof `user_rule` \u2014 so no automatic rung and no model run can overwrite it.\nFiling under the same payee is what makes sorting compound rather than\nbeing busywork: one decision covers every month that follows.",
        "operationId": "file_transaction_v1_transactions__transaction_id__category_post",
        "parameters": [
          {
            "in": "path",
            "name": "transaction_id",
            "required": true,
            "schema": {
              "title": "Transaction Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FileTransactionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileTransactionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "File a transaction under a category",
        "tags": [
          "screens"
        ]
      }
    },
    "/v1/unlock": {
      "post": {
        "operationId": "unlock_account_v1_unlock_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UnlockRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnlockResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Password for a bank's statements",
        "tags": [
          "documents"
        ]
      }
    }
  }
