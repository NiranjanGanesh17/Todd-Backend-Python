        "tags": [
          "health"
        ]
      }
    },
    "/v1/documents": {
      "get": {
        "operationId": "list_documents_v1_documents_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DocumentOut"
                  },
                  "title": "Response List Documents V1 Documents Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Stored statements",
        "tags": [
          "documents"
        ]
      },
      "post": {
        "description": "Store each PDF, then parse it.\n\nCounts answer the three things the web app distinguishes: accepted,\nwaiting on a password, and already seen. A duplicate is identified by\ncontent hash, so the same statement forwarded twice is one document.",
        "operationId": "upload_documents_v1_documents_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_documents_v1_documents_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Upload statement PDFs",
        "tags": [
          "documents"
        ]
      }
    },
    "/v1/documents/{documentId}/unlock": {
      "post": {
        "operationId": "unlock_document_v1_documents__documentId__unlock_post",
        "parameters": [
          {
            "in": "path",
            "name": "documentId",
            "required": true,
            "schema": {
              "title": "Documentid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UnlockRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnlockResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Password for one locked PDF",
        "tags": [
          "documents"
        ]
      }
    },
    "/v1/gmail": {
      "delete": {
        "operationId": "gmail_disconnect_v1_gmail_delete",
        "responses": {
