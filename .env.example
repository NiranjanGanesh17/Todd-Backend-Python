# Todd backend — every key the service reads. No real values in this file.
# Copy to .env and fill in. Config is validated once at boot (todd/config.py).

# ---- app
APP_ENV=development              # development | test | production
LOG_LEVEL=info
PORT=8080
WEB_ORIGIN=http://localhost:3000

# ---- database
DATABASE_URL=postgresql+psycopg://todd:todd@localhost:5432/todd
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# ---- redis (queues, readiness probe)
REDIS_URL=redis://localhost:6379/0

# ---- supabase (storage + auth)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=statements

# ---- google / gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/v1/gmail/callback
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_VERIFICATION_TOKEN=
GMAIL_RATE_LIMIT_PER_MINUTE=60

# ---- anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=
ANTHROPIC_MODEL_SMART=
LLM_DAILY_COST_CAP_MICROS=

# ---- encryption (envelope encryption for secrets and refresh tokens)
# Missing in development -> a fixed dev constant is used and a warning logged.
# Never a per-process random key: a secret sealed by one process must open in another.
ENCRYPTION_MASTER_KEY=
ENCRYPTION_KEY_ID=dev-1

# ---- web push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ---- pro / goals
GOALS_ENABLED=false
PRO_LOCK_MODE=waitlist           # upgrade | waitlist
PRO_PRICE_PAISE=                 # required when PRO_LOCK_MODE=upgrade

# ---- retention / observability
RAW_BODY_RETENTION_DAYS=30
SENTRY_DSN=

# ---- dev auth bypass — must hard-fail when APP_ENV=production
AUTH_DEV_BYPASS=false
AUTH_DEV_USER_ID=
AUTH_DEV_USER_EMAIL=
